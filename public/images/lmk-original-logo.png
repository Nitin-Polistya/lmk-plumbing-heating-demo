<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="600" height="600">
  <defs>
    <filter id="badgeShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.35"/>
    </filter>
  </defs>

  <!-- Outer Hot Pink Circular Frame -->
  <circle cx="300" cy="300" r="285" fill="#E317A8" filter="url(#badgeShadow)" />
  <circle cx="300" cy="300" r="272" fill="#0F1720" stroke="#FFFFFF" stroke-width="5" />
  
  <!-- Outer Text Arc Ring -->
  <path id="arcTop" d="M 80,300 A 220,220 0 1,1 520,300" fill="none" />
  <path id="arcBottom" d="M 520,300 A 220,220 0 0,1 80,300" fill="none" />

  <text font-family="'Arial Black', 'Impact', sans-serif" font-weight="900" font-size="34" fill="#FFFFFF" letter-spacing="4">
    <textPath href="#arcTop" startOffset="50%" text-anchor="middle">
      LMK PLUMBING &amp; HEATING
    </textPath>
  </text>

  <text font-family="'Arial Black', sans-serif" font-weight="800" font-size="26" fill="#E317A8" letter-spacing="2">
    <textPath href="#arcBottom" startOffset="50%" text-anchor="middle">
      ★ SERVICES • WAKEFIELD ★
    </textPath>
  </text>

  <!-- Inner Circle Base -->
  <circle cx="300" cy="300" r="195" fill="#E317A8" />
  <circle cx="300" cy="300" r="183" fill="#FFFFFF" stroke="#0F1720" stroke-width="7" />

  <!-- Background Crossed Wrench & Pipe Tools -->
  <g stroke="#0F1720" stroke-width="14" stroke-linecap="round">
    <line x1="180" y1="180" x2="420" y2="420" />
    <line x1="420" y1="180" x2="180" y2="420" />
  </g>
  <g stroke="#E317A8" stroke-width="7" stroke-linecap="round">
    <line x1="180" y1="180" x2="420" y2="420" />
    <line x1="420" y1="180" x2="180" y2="420" />
  </g>

  <!-- Central Panther Mascot Face -->
  <g transform="translate(300, 280)">
    <!-- Ears -->
    <path d="M -70,-55 L -100,-125 L -40,-90 Z" fill="#0F1720" stroke="#FFFFFF" stroke-width="4"/>
    <path d="M 70,-55 L 100,-125 L 40,-90 Z" fill="#0F1720" stroke="#FFFFFF" stroke-width="4"/>
    <path d="M -65,-60 L -90,-110 L -45,-85 Z" fill="#E317A8" />
    <path d="M 65,-60 L 90,-110 L 45,-85 Z" fill="#E317A8" />

    <!-- Head Contour -->
    <path d="M 0,-80 C -80,-80 -100,-10 -90,35 C -75,80 -40,100 0,100 C 40,100 75,80 90,35 C 100,-10 80,-80 0,-80 Z" fill="#0F1720" stroke="#FFFFFF" stroke-width="5"/>

    <!-- Panther Eyes -->
    <polygon points="-50,-30 -18,-18 -30,0" fill="#E317A8" />
    <polygon points="50,-30 18,-18 30,0" fill="#E317A8" />
    <circle cx="-34" cy="-16" r="3.5" fill="#FFFFFF" />
    <circle cx="34" cy="-16" r="3.5" fill="#FFFFFF" />

    <!-- Snout & Water Drop -->
    <path d="M -30,20 C -30,42 30,42 30,20 C 30,0 -30,0 -30,20 Z" fill="#FFFFFF" />
    <polygon points="0,18 -12,6 12,6" fill="#E317A8" />
    <path d="M 0,-65 C -10,-48 -15,-36 0,-22 C 15,-36 10,-48 0,-65 Z" fill="#E317A8" stroke="#FFFFFF" stroke-width="2" />
  </g>

  <!-- Intact Gas Safe Badge Stamp embedded inside original artwork -->
  <g transform="translate(420, 320)">
    <rect x="-35" y="-20" width="70" height="40" rx="6" fill="#FFC800" stroke="#000000" stroke-width="3"/>
    <text x="0" y="-3" font-family="'Arial Black', sans-serif" font-weight="900" font-size="10" fill="#000000" text-anchor="middle">GAS SAFE</text>
    <text x="0" y="11" font-family="'Arial Black', sans-serif" font-weight="800" font-size="8" fill="#000000" text-anchor="middle">REGISTER</text>
  </g>

  <!-- Bottom Contact Ribbon with Phone Number -->
  <rect x="130" y="440" width="340" height="60" rx="30" fill="#0F1720" stroke="#E317A8" stroke-width="5" />
  <text x="300" y="480" font-family="'Courier New', monospace" font-weight="900" font-size="28" fill="#FFFFFF" text-anchor="middle" letter-spacing="2">
    07805 329803
  </text>
</svg>